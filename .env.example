
DATABASE_URL="postgresql://keystone:keystone@localhost:5433/keystone_vendor_dashboard?schema=public"
DIRECT_URL="postgresql://keystone:keystone@localhost:5433/keystone_vendor_dashboard?schema=public"


JWT_ACCESS_SECRET="your-access-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

APP_URL="http://localhost:3000"

ZOHO_ENABLED="true"
ZOHO_DC="in"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_ORGANIZATION_ID=""
# "bills" = supplier bills (what we owe) — the procurement flow: an approved PO is
# converted to a Bill in Zoho, and that Bill syncs back here.
# "invoices" = customer invoices (what customers owe us).
ZOHO_INVOICE_SOURCE="bills"


ZOHO_WEBHOOK_SECRET=""   
CRON_SECRET=""           


GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL=""
GMAIL_SENDER_NAME="Keystone Procurement"


# Catalogue file storage (service account). Set the enable flag to "true" or the app
# uses an in-memory MOCK Drive — uploads appear to succeed but nothing is stored.
DRIVE_ENABLED="true"
DRIVE_CATALOGUES_FOLDER_ID=""
DRIVE_SERVICE_ACCOUNT_JSON=""
# DRIVE_SERVICE_ACCOUNT_JSON_PATH — local dev alternative: path to the key file

# Vendor catalogue browsing (OAuth).
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""


